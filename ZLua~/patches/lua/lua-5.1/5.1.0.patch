diff --git a/src/lapi.c b/patched/src/lapi.c
--- a/src/lapi.c
+++ b/src/lapi.c
@@ -76,6 +76,16 @@ static TValue *index2adr (lua_State *L, int idx) {
 }
 
 
+#if ZLUA_FAST_METATABLE
+/*
+** Expose index2adr to zlua_fastmt.c without duplicating the implementation.
+*/
