diff --git a/patched/src/zlua_fastmt.c b/patched/src/zlua_fastmt.c
new file mode 100644
--- /dev/null
+++ b/src/zlua_fastmt.c
@@ -0,0 +1,79 @@
+/*
+** ZLua sealed-metatable support for PUC-Rio Lua 5.1 VM.
+*/
+#define LUA_CORE
+
+#include "lua.h"
+#include "lauxlib.h"
+
+#include "lapi.h"
+#include "ldo.h"
+#include "lfunc.h"
+#include "lgc.h"
+#include "lobject.h"
+#include "lstate.h"
+#include "ltable.h"
+#include "ltm.h"
+#include "zlua_fastmt.h"
+
+#if ZLUA_FAST_METATABLE
+
+/* Defined in lapi.c -thin wrapper around static index2adr. */
+TValue *zlua_index2value (lua_State *L, int idx);
+
+LUA_API void zlua_mt_seal (lua_State *L, int mtIndex) {
+  Table *mt;
+  const TValue *idx;
+  const TValue *nidx;
+  TValue *o;
+  lua_lock(L);
+  o = zlua_index2value(L, mtIndex);
+  api_check(L, ttistable(o));
+  mt = hvalue(o);
+  idx = luaH_getstr(mt, G(L)->tmname[TM_INDEX]);
+  nidx = luaH_getstr(mt, G(L)->tmname[TM_NEWINDEX]);
+  if (ttisnil(idx) || !ttistable(idx)) {
+    lua_unlock(L);
+    luaL_error(L, "zlua_mt_seal: __index must be a table");
+  }
+  if (ttisnil(nidx) || !ttistable(nidx)) {
+    lua_unlock(L);
+    luaL_error(L, "zlua_mt_seal: __newindex must be a table");
+  }
+  setobj(L, &mt->zlua_index, idx);
+  setobj(L, &mt->zlua_newindex, nidx);
+  luaC_barriert(L, mt, idx);
+  luaC_barriert(L, mt, nidx);
+  mt->zlua_mt_kind = 1;
+  lua_unlock(L);
+}
+
+
+LUA_API void zlua_vm_call_getter (lua_State *L, const TValue *f,
+                                  const TValue *obj, StkId res) {
+  ptrdiff_t result = savestack(L, res);
+  StkId func;
+  luaD_checkstack(L, 2);
+  func = L->top;
+  setobj2s(L, func, f);
+  setobj2s(L, func + 1, obj);
+  L->top += 2;
+  luaD_call(L, func, 1);
+  res = restorestack(L, result);
+  setobjs2s(L, res, --L->top);
+}
+
+
+LUA_API void zlua_vm_call_setter (lua_State *L, const TValue *f,
+                                  const TValue *obj, StkId val) {
+  StkId func;
+  luaD_checkstack(L, 3);
+  func = L->top;
+  setobj2s(L, func, f);
+  setobj2s(L, func + 1, obj);
+  setobj2s(L, func + 2, val);
+  L->top += 3;
+  luaD_call(L, func, 0);
+}
+
+#endif /* ZLUA_FAST_METATABLE */
diff --git a/patched/src/zlua_fastmt.h b/patched/src/zlua_fastmt.h
new file mode 100644
--- /dev/null
+++ b/src/zlua_fastmt.h
@@ -0,0 +1,36 @@
+/*
+** ZLua sealed-metatable helpers (FastMT) for PUC-Rio Lua 5.1.
+** Active when ZLUA_FAST_METATABLE != 0 (luaconf.h).
+*/
+#ifndef zlua_fastmt_h
+#define zlua_fastmt_h
+
+#include "luaconf.h"
+#include "lua.h"
+#include "lobject.h"
+
+#if ZLUA_FAST_METATABLE
+
+/* Tagged field/property accessors; VM compares CClosure->f to these. */
+LUA_API int zlua_index_getter (lua_State *L);  /* (obj) -> value */
+LUA_API int zlua_index_setter (lua_State *L);  /* (obj, value) -> 0 */
+
+/* After __index/__newindex tables are set on mt, cache them and mark sealed. */
+LUA_API void zlua_mt_seal (lua_State *L, int mtIndex);
+
+/* VM helpers: call tagged closures without going through __index. */
+LUA_API void zlua_vm_call_getter (lua_State *L, const TValue *f,
+                                  const TValue *obj, StkId res);
+LUA_API void zlua_vm_call_setter (lua_State *L, const TValue *f,
+                                  const TValue *obj, StkId val);
+
+/* Lua 5.1: no ttisCclosure; C closures are LUA_TFUNCTION with isC != 0. */
+#define zlua_is_getter(o) \
+  (ttisfunction(o) && clvalue(o)->c.isC && clvalue(o)->c.f == zlua_index_getter)
+
+#define zlua_is_setter(o) \
+  (ttisfunction(o) && clvalue(o)->c.isC && clvalue(o)->c.f == zlua_index_setter)
+
+#endif /* ZLUA_FAST_METATABLE */
+
+#endif
