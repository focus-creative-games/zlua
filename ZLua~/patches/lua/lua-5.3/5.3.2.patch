Subject: [PATCH] FastMT for lua-5.3.2

diff --git a/src/lapi.c b/patched/src/lapi.c
index 9a6a3fb..63e75a1 100644
--- a/src/lapi.c
+++ b/src/lapi.c
@@ -84,6 +84,17 @@ static TValue *index2addr (lua_State *L, int idx) {
 }
 
 
+#if ZLUA_FAST_METATABLE
+/*
+** Expose index2addr to zlua_fastmt.c without duplicating the implementation
+** (keeps multi-version Lua ports in sync with PUC-Rio lapi.c).
+*/
+TValue *zlua_index2value (lua_State *L, int idx) {
+  return index2addr(L, idx);
+}
+#endif
+
+
 /*
 ** to be called by 'lua_checkstack' in protected mode, to grow stack
 ** capturing memory errors
diff --git a/src/lgc.c b/patched/src/lgc.c
index 49d8ecb..1a9a177 100644
--- a/src/lgc.c
+++ b/src/lgc.c
@@ -452,6 +452,12 @@ static lu_mem traversetable (global_State *g, Table *h) {
   const char *weakkey, *weakvalue;
   const TValue *mode = gfasttm(g, h->metatable, TM_MODE);
   markobjectN(g, h->metatable);
+#if ZLUA_FAST_METATABLE
+  if (h->zlua_mt_kind != 0) {
+    markvalue(g, &h->zlua_index);
+    markvalue(g, &h->zlua_newindex);
+  }
+#endif
   if (mode && ttisstring(mode) &&  /* is there a weak mode? */
       ((weakkey = strchr(svalue(mode), 'k')),
        (weakvalue = strchr(svalue(mode), 'v')),
diff --git a/src/lobject.h b/patched/src/lobject.h
