+          return;
+        }
+        /* Static type table: extras such as _default live on SMT itself. */
+        {
+          const TValue *extra = luaH_get(mt, key);
+          if (!ttisnil(extra)) {
+            setobj2s(L, val, extra);
+            return;
+          }
+        }
+        /* Reserved keys (__byval_instance_mt, __nameof, ...) stay nil when absent. */
+        if (ttisstring(key)) {
+          TString *ks = tsvalue(key);
+          const char *s = getstr(ks);
+          if (s[0] == '_' && s[1] == '_') {
+            setnilvalue(val);
+            return;
+          }
+        }
+        {
+          const TValue *tn = luaH_getstr(mt, luaS_newliteral(L, "__zlua_typename"));
+          const char *typeName = (tn != NULL && !ttisnil(tn) && ttisstring(tn))
+                                     ? getstr(tsvalue(tn)) : "?";
+          const char *memberName = ttisstring(key) ? getstr(tsvalue(key)) : "?";
+          luaG_runerror(L, "zlua: member not found: %s.%s", typeName, memberName);
+        }
+      }
+#endif
     }
     else if (ttisnil(tm = luaT_gettmbyobj(L, t, TM_INDEX)))
       luaG_typeerror(L, t, "index");  /* no metamethod */
+#if ZLUA_FAST_METATABLE
+    else if (ttisfulluserdata(t)) {
+      Table *mt = uvalue(t)->metatable;
+      if (mt != NULL && mt->zlua_mt_kind != 0) {
+        Table *idx = hvalue(&mt->zlua_index);
+        const TValue *slotv = luaH_get(idx, key);
+        if (!ttisnil(slotv)) {
+          if (zlua_is_getter(slotv))
+            zlua_vm_call_getter(L, slotv, t, val);
+          else
+            setobj2s(L, val, slotv);
+          return;
+        }
+        /* Reserved keys (__byval_instance_mt, __nameof, ...) stay nil when absent. */
+        if (ttisstring(key)) {
+          TString *ks = tsvalue(key);
+          const char *s = getstr(ks);
+          if (s[0] == '_' && s[1] == '_') {
+            setnilvalue(val);
+            return;
+          }
+        }
+        {
+          const TValue *tn = luaH_getstr(mt, luaS_newliteral(L, "__zlua_typename"));
+          const char *typeName = (tn != NULL && !ttisnil(tn) && ttisstring(tn))
+                                     ? getstr(tsvalue(tn)) : "?";
+          const char *memberName = ttisstring(key) ? getstr(tsvalue(key)) : "?";
+          luaG_runerror(L, "zlua: member not found: %s.%s", typeName, memberName);
+        }
+      }
+    }
+#endif
     if (ttisfunction(tm)) {  /* metamethod is a function */
       luaT_callTM(L, tm, t, key, val, 1);
       return;
@@ -194,6 +239,47 @@ void luaV_gettable (lua_State *L, const TValue *t, TValue *key, StkId val) {
 void luaV_settable (lua_State *L, const TValue *t, TValue *key, StkId val) {
   int loop;  /* counter to avoid infinite loops */
   for (loop = 0; loop < MAXTAGLOOP; loop++) {
+#if ZLUA_FAST_METATABLE
