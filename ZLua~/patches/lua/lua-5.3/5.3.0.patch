@@ -174,9 +176,80 @@ void luaV_gettable (lua_State *L, const TValue *t, TValue *key, StkId val) {
         return;
       }
       /* else will try metamethod */
+#if ZLUA_FAST_METATABLE
+      /* After raw miss: sealed SMT (often setmetatable(T,T)) serves memberTable. */
+      if (h->metatable != NULL && h->metatable->zlua_mt_kind != 0) {
+        Table *mt = h->metatable;
+        Table *idx = hvalue(&mt->zlua_index);
+        const TValue *slotv = luaH_get(idx, key);
+        if (!ttisnil(slotv)) {
