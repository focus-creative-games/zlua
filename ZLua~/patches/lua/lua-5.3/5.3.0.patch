diff --git a/src/luaconf.h b/patched/src/luaconf.h
--- a/src/luaconf.h
+++ b/src/luaconf.h
@@ -727,6 +727,17 @@
 ** without modifying the main part of the file.
 */
 
+/*
+@@ ZLUA_FAST_METATABLE controls ZLua member-index optimization.
+** 0: legacy C __index/__newindex.
+** 1: sealed mt + member/setter tables + VM gettable/settable fast path.
+** Default 1: raw-first gettable FastMT (same ordering as 5.1/5.2).
+*/
+#if !defined(ZLUA_FAST_METATABLE)
+#define ZLUA_FAST_METATABLE 1
+#endif
+
+
 
 
 
